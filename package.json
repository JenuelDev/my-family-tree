{
  "name": "testning-only",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "build:for:app": "run-p type-check build-only:for:app",
    "preview": "vite preview",
    "build-only": "vite build",
    "build-only:for:app": "vite build --outDir ./fam-tree-app/src/dist --emptyOutDir --base ./",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "app:start": "cd fam-tree-app && yarn start"
  },
  "dependencies": {
    "@balkangraph/familytree.js": "^1.9.47",
    "@vueuse/core": "^10.11.1",
    "dayjs": "^1.11.19",
    "firebase": "^10.14.1",
    "notiflix": "^3.2.8",
    "pinia": "^2.3.1",
    "primevue": "^3.53.1",
    "scrollreveal": "^4.0.9",
    "snap-storage": "^0.2.5",
    "vue": "^3.5.29",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@iconify/vue": "^4.3.0",
    "@tsconfig/node18": "^2.0.1",
    "@types/node": "^18.19.130",
    "@unocss/preset-web-fonts": "^0.53.6",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vue/tsconfig": "^0.4.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.97.3",
    "typescript": "~5.0.4",
    "unocss": "^0.58.9",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.16.7",
    "vue-tsc": "^1.8.27"
  }
}
